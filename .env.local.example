# Copiar a .env.local y llenar. Nunca subir .env.local a git.

# Supabase (Project Settings → API). La clave pública puede ser la
# publishable key (sb_publishable_...) o la anon key heredada.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (para el enlace del magic link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI — verificar en la documentación qué modelos están vigentes.
# Elegidos en oct 2026: gpt-transcribe (los *-transcribe y whisper-1 se apagan en feb 2027)
# y gpt-5.6-terra (salidas estructuradas + imágenes).
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-5.6-terra
AI_DAILY_CALL_LIMIT=100

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Cron
CRON_SECRET=
